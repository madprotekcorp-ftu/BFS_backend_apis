# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://bfs:bfs@localhost:5432/bfs

# Frontend origins (comma-separated). Never use a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Cookie domain shared with the frontend, e.g. .example.com in production. Empty in dev.
SESSION_COOKIE_DOMAIN=

# Uploaded documents live here, outside any public web root.
PRIVATE_MEDIA_ROOT=./private_media
DOCUMENT_MAX_SIZE_MB=10
IMPORT_MAX_ROWS=5000
TIME_ZONE=Asia/Kolkata

# --- Optional ---
# Number of reverse proxies in front of Django (1 behind Nginx). Used for per-IP throttles.
NUM_PROXIES=0
# Swagger UI at /api/docs/ (on by default only when DEBUG is on; enable on staging).
API_DOCS_ENABLED=
# Django admin at /django-admin/ (on by default only when DEBUG is on).
DJANGO_ADMIN_ENABLED=
# Production only: let Nginx serve document bytes via X-Accel-Redirect.
DOCUMENTS_USE_X_ACCEL=
